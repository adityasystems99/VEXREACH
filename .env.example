# VEXReach Environment Configuration Example
# Copy to `.env` for local development or configure in Kubernetes ConfigMaps / Secrets.
# NEVER commit real API tokens or cluster credentials.

# Core Runtime
VEXREACH_ENVIRONMENT=development
VEXREACH_LOG_LEVEL=INFO
VEXREACH_LOG_FORMAT=console
VEXREACH_STORAGE_PATH=.vexreach/vexreach.db
VEXREACH_DEFAULT_OUTPUT_DIR=.vexreach/assessments

# Trivy Discovery Engine
VEXREACH_TRIVY_PATH=trivy
VEXREACH_TRIVY_TIMEOUT_SECONDS=300
VEXREACH_MAX_SCANNER_OUTPUT_BYTES=52428800

# Static Analysis Safeguards
VEXREACH_MAX_GRAPH_DEPTH=15
VEXREACH_MAX_CALL_PATHS=50
VEXREACH_MAX_PYTHON_FILES=5000
VEXREACH_MAX_GO_FILES=5000
VEXREACH_MAX_GRAPH_NODES=50000
VEXREACH_MAX_GRAPH_EDGES=200000
VEXREACH_GO_PATH=go
VEXREACH_GO_ANALYZER_BINARY_PATH=
VEXREACH_GO_TIMEOUT_SECONDS=120

# OSV.dev Vulnerability Intelligence
VEXREACH_OSV_API_BASE_URL=https://api.osv.dev/v1
VEXREACH_OSV_CACHE_ENABLED=true
VEXREACH_OSV_CACHE_TTL_SECONDS=86400

# Optional Threat Feeds (FIRST EPSS & CISA KEV)
VEXREACH_EPSS_API_URL=https://api.first.org/data/v1/epss
VEXREACH_KEV_CATALOG_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# Optional AI Security Intelligence Provider
# Supported: disabled | heuristic | openai | openai_compatible | openrouter | anthropic | gemini | ollama
VEXREACH_LLM_PROVIDER=disabled
VEXREACH_LLM_MODEL=gpt-4o-mini
VEXREACH_LLM_API_BASE_URL=
VEXREACH_LLM_API_KEY=
VEXREACH_LLM_TIMEOUT_SECONDS=45.0
VEXREACH_LLM_MAX_RETRIES=2

# FastAPI REST API Server & Security Governance
VEXREACH_API_HOST=127.0.0.1
VEXREACH_API_PORT=8000
VEXREACH_API_AUTH_ENABLED=false
# Comma-separated or JSON key:role mappings, e.g. dev-token:admin,ci-token:operator
VEXREACH_API_KEYS=
VEXREACH_API_MAX_REQUEST_BYTES=5242880
VEXREACH_API_RATE_LIMIT_PER_MINUTE=120
VEXREACH_API_CORS_ORIGINS=["http://localhost:3000"]

# Optional Kubernetes Backend Context (Not required for CLI or standalone API)
VEXREACH_KUBERNETES_ENABLED=false
VEXREACH_KUBERNETES_NAMESPACE=default
VEXREACH_KUBECONFIG_PATH=
